# Copy to .env and fill in from Supabase → Project Settings → API Keys.
# Use the Project URL and the anon / publishable key — NEVER the service_role / secret key.
# These two values are public by design; Row Level Security (supabase/schema.sql) protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
